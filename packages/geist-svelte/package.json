{
  "name": "geist-svelte",
  "version": "1.0.2",
  "description": "Geist font family for Svelte/SvelteKit: Sans, Mono, Serif, and Pixel variants by Vercel.",
  "type": "module",
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "geist",
    "geist mono",
    "geist sans",
    "geist pixel",
    "geist serif",
    "vercel font",
    "svelte",
    "sveltekit",
    "font"
  ],
  "license": "MIT AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jis3r/geist-svelte.git"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./font/sans": {
      "types": "./dist/font/sans.d.ts",
      "svelte": "./dist/font/sans.js",
      "default": "./dist/font/sans.js"
    },
    "./font/sans-non-variable": {
      "types": "./dist/font/sans-non-variable.d.ts",
      "svelte": "./dist/font/sans-non-variable.js",
      "default": "./dist/font/sans-non-variable.js"
    },
    "./font/mono": {
      "types": "./dist/font/mono.d.ts",
      "svelte": "./dist/font/mono.js",
      "default": "./dist/font/mono.js"
    },
    "./font/mono-non-variable": {
      "types": "./dist/font/mono-non-variable.d.ts",
      "svelte": "./dist/font/mono-non-variable.js",
      "default": "./dist/font/mono-non-variable.js"
    },
    "./font/pixel": {
      "types": "./dist/font/pixel.d.ts",
      "svelte": "./dist/font/pixel.js",
      "default": "./dist/font/pixel.js"
    },
    "./font/serif": {
      "types": "./dist/font/serif.d.ts",
      "svelte": "./dist/font/serif.js",
      "default": "./dist/font/serif.js"
    },
    "./font/serif/variable": {
      "types": "./dist/font/serif/variable.d.ts",
      "svelte": "./dist/font/serif/variable.js",
      "default": "./dist/font/serif/variable.js"
    },
    "./font/serif/regular": {
      "types": "./dist/font/serif/regular.d.ts",
      "svelte": "./dist/font/serif/regular.js",
      "default": "./dist/font/serif/regular.js"
    },
    "./font/serif/square": {
      "types": "./dist/font/serif/square.d.ts",
      "svelte": "./dist/font/serif/square.js",
      "default": "./dist/font/serif/square.js"
    },
    "./font/serif/triangle": {
      "types": "./dist/font/serif/triangle.d.ts",
      "svelte": "./dist/font/serif/triangle.js",
      "default": "./dist/font/serif/triangle.js"
    },
    "./font/serif/heart": {
      "types": "./dist/font/serif/heart.d.ts",
      "svelte": "./dist/font/serif/heart.js",
      "default": "./dist/font/serif/heart.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "OFL.txt",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3"
  }
}